# Copy this file to `.env.local` and fill in your own Supabase project values.
# `.env.local` is already gitignored (`*.local`), so it is never committed.
#
# Get both values from:
#   Supabase dashboard -> your project -> Settings -> API
#
# BOTH VALUES ARE PUBLIC. They ship inside the browser bundle, which is safe
# because they only grant what `supabase/schema.sql` allows — and those policies
# restrict every row to its owner. Never put the `service_role` key here: it
# bypasses row-level security entirely and must stay server-side.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
